# Variables de entorno del servicio de cifrado (EJEMPLO — sin valores reales)
# Copiar a .env y completar con los valores del entorno (Codespace).
# NUNCA subir .env al repositorio (ver .gitignore).

# Puerto del servicio
PORT=3000

# Llaves RSA (generadas con el módulo del servicio; fuera del repo)
RSA_PRIVATE_KEY_PATH=/ruta/a/llave-privada.pem
RSA_PUBLIC_KEY_PATH=/ruta/a/llave-publica.pem

# Keycloak (IAM)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=appmovil
KEYCLOAK_CLIENT_ID=servicio-cifrado
KEYCLOAK_CLIENT_SECRET=secret-del-cliente

# Bitácora
DB_PATH=/ruta/a/bitacora.db

# Límites de entrada (mitigan DoS)
MAX_INPUT_SIZE_BYTES=1048576