# ============================================================================
#  servidor/.env.example  -  Plantilla de configuracion (SIN secretos reales)
#  >>> AGREGADO EN FASE 2 <<<
#  Copiar como .env y completar con valores del entorno. NUNCA commitear .env.
#  Gitleaks pasa verde: aqui no hay AWS keys, JWT ni passwords validos.
# ============================================================================
# Token de cifrado: usar un secreto aleatorio largo (ej: openssl rand -base64 48)
JWT_SECRET=reemplazar-por-secreto-aleatorio

# Cadena de conexion: <usuario>:<password>@<host>:<puerto>/<base>
DATABASE_URL=mysql://usuario:password@localhost:3306/appmovil

# Credenciales AWS (opcionales): completar solo en el .env local
AWS_ACCESS_KEY_ID=reemplazar
AWS_SECRET_ACCESS_KEY=reemplazar

# Control de acceso y CORS
AUTH_ENABLED=true
ORIGENES_PERMITIDOS=http://localhost:3000
PORT=3000
